{
  "name": "cleanmycodex",
  "version": "0.1.7",
  "description": "Codex 空间扫描与清理工具",
  "main": "out/main/index.js",
  "author": "FinnaXxx",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "build:mac": "pnpm build && node scripts/electron-builder.cjs --mac",
    "build:win": "pnpm build && node scripts/electron-builder.cjs --win",
    "build:win-arm64": "pnpm build && node scripts/electron-builder.cjs --win nsis --arm64",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
